# 夹具是逐字节比较的产物（tools/reference/singlefactor/make_outsource_fixtures.py
# --check）：禁止 git 做换行转换，否则 Windows 检出（core.autocrlf=true）会把
# .xml 夹具改成 CRLF，字节与生成器输出不再一致。
tests/fixtures/** -text

# Vendored 字体与上游许可按锁定 SHA-256 原字节检出，跨平台禁止换行转换。
resources/fonts/*.otf -text
resources/fonts/*.ttf -text
# 上游许可有原始行尾空格；保留原字节以匹配锁定哈希，仅该文件不做空白检查。
resources/fonts/OFL-IBMPlex.txt -text -whitespace
