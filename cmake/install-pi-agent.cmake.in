# Stages the same verified generation in the build tree and relocated installation.
cmake_minimum_required(VERSION 3.28)
set(_pi_anchor [==[@_paleo_pi_anchor@]==])
function(_pi_verify root)
  if(IS_SYMLINK "${root}" OR IS_SYMLINK "${root}/pi-manifest.json")
    message(FATAL_ERROR "Pi runtime links are forbidden")
  endif()
  file(SIZE "${root}/pi-manifest.json" _size)
  if(_size LESS 1 OR _size GREATER 1048576)
    message(FATAL_ERROR "Pi manifest byte budget exceeded")
  endif()
  file(SHA256 "${root}/pi-manifest.json" _sha)
  if(NOT _sha STREQUAL _pi_anchor)
    message(FATAL_ERROR "Pi manifest differs from host-approved SHA-256")
  endif()
  file(READ "${root}/pi-manifest.json" _json LIMIT 1048576)
  foreach(_pair IN ITEMS "schema|paleo.pi-runtime.v1" "sourceLockSha256|@PALEO_PI_LOCK_SHA@"
      "upstreamCommit|@PALEO_PI_UPSTREAM@" "coreVersion|@PALEO_PI_CORE_VERSION@" "nodeVersion|@PALEO_PI_NODE_VERSION@"
      "runtimeVersion|@PALEO_PI_RUNTIME_VERSION@" "platform|@PALEO_PI_PLATFORM@" "entry|agent/sidecar.mjs")
    string(REPLACE "|" ";" _fields "${_pair}")
    list(GET _fields 0 _key)
    list(GET _fields 1 _expected)
    string(JSON _value GET "${_json}" "${_key}")
    if(NOT _value STREQUAL _expected)
      message(FATAL_ERROR "Pi manifest incompatible field: ${_key}")
    endif()
  endforeach()
  string(JSON _node GET "${_json}" node)
  if(NOT _node STREQUAL "bin/node" AND NOT _node STREQUAL "bin/node.exe")
    message(FATAL_ERROR "Invalid Pi Node path")
  endif()
  string(JSON _count LENGTH "${_json}" files)
  if(_count LESS 1 OR _count GREATER 512)
    message(FATAL_ERROR "Pi file budget exceeded")
  endif()
  math(EXPR _last "${_count}-1")
  set(_files "pi-manifest.json")
  set(_folded "pi-manifest.json")
  set(_total 0)
  set(_has_node FALSE)
  set(_has_entry FALSE)
  file(REAL_PATH "${root}" _root_real)
  foreach(_index RANGE 0 ${_last})
    string(JSON _path GET "${_json}" files ${_index} path)
    string(JSON _size GET "${_json}" files ${_index} size)
    string(JSON _sha GET "${_json}" files ${_index} sha256)
    if(_path MATCHES "(^/|\\\\|:|;|[\r\n]|(^|/)\\.\\.?(/|$)|//|/$|[ .](/|$))" OR NOT _size MATCHES "^[1-9][0-9]*$" OR _size GREATER 268435456)
      message(FATAL_ERROR "Invalid Pi file declaration")
    endif()
    string(TOLOWER "${_path}" _lower)
    if(_lower IN_LIST _folded OR IS_DIRECTORY "${root}/${_path}" OR IS_SYMLINK "${root}/${_path}")
      message(FATAL_ERROR "Duplicate/missing/linked Pi file")
    endif()
    file(REAL_PATH "${root}/${_path}" _real)
    string(FIND "${_real}" "${_root_real}/" _inside)
    if(NOT _inside EQUAL 0)
      message(FATAL_ERROR "Pi file escaped the prepared root")
    endif()
    file(SIZE "${root}/${_path}" _actual_size)
    file(SHA256 "${root}/${_path}" _actual_sha)
    if(NOT _actual_size EQUAL _size OR NOT _actual_sha STREQUAL _sha)
      message(FATAL_ERROR "Pi file size/SHA-256 mismatch")
    endif()
    if(_path STREQUAL _node)
      if(NOT _sha STREQUAL "@PALEO_PI_NODE_SHA@")
        message(FATAL_ERROR "Unreviewed Node program")
      endif()
      set(_has_node TRUE)
    elseif(_path STREQUAL "agent/sidecar.mjs")
      if(NOT _sha STREQUAL "@PALEO_PI_BUNDLE_SHA@")
        message(FATAL_ERROR "Unreviewed Pi entry bundle")
      endif()
      set(_has_entry TRUE)
    endif()
    math(EXPR _total "${_total}+${_size}")
    list(APPEND _files "${_path}")
    list(APPEND _folded "${_lower}")
  endforeach()
  string(JSON _tree_size GET "${_json}" treeSize)
  if(NOT _total EQUAL _tree_size OR _total GREATER 268435456 OR NOT _has_node OR NOT _has_entry)
    message(FATAL_ERROR "Pi payload identity/total budget mismatch")
  endif()
  file(GLOB_RECURSE _entries LIST_DIRECTORIES TRUE RELATIVE "${root}" "${root}/*" "${root}/.*")
  list(LENGTH _entries _entry_count)
  if(_entry_count GREATER 2048)
    message(FATAL_ERROR "Pi directory entry budget exceeded")
  endif()
  foreach(_entry IN LISTS _entries)
    if(IS_SYMLINK "${root}/${_entry}" OR (NOT IS_DIRECTORY "${root}/${_entry}" AND NOT _entry IN_LIST _files))
      message(FATAL_ERROR "Extra or linked Pi payload entry")
    endif()
  endforeach()
  set(_pi_files "${_files}" PARENT_SCOPE)
  set(_pi_node "${_node}" PARENT_SCOPE)
endfunction()
if(DEFINED PI_BUILD_PREFIX)
  set(_pi_source [==[@_paleo_pi_source@]==])
  set(_pi_generations "${PI_BUILD_PREFIX}/libexec/pi-agent/generations")
else()
  set(_pi_source [==[@CMAKE_BINARY_DIR@/libexec/pi-agent/generations/@_paleo_pi_anchor@]==])
  set(_pi_generations "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/libexec/pi-agent/generations")
endif()
file(MAKE_DIRECTORY "${_pi_generations}")
file(LOCK "${_pi_generations}/.pi-install.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE _pi_locked)
if(NOT _pi_locked STREQUAL "0")
  message(FATAL_ERROR "Pi deployment store is busy")
endif()
if("@PALEO_PI_PLATFORM@" STREQUAL "linux-x86_64")
  set(_loader "${_pi_generations}/../loaders/@PALEO_PI_LOADER_ID@")
  set(_build_loader [==[@CMAKE_BINARY_DIR@/libexec/pi-agent/loaders/@PALEO_PI_LOADER_ID@]==])
  foreach(_lib IN ITEMS "libgcc_s.so.1" "libstdc++.so.6")
    if(_lib STREQUAL "libgcc_s.so.1")
      set(_src [==[@PALEO_PI_GCC_FILE@]==])
      set(_expected "@PALEO_PI_GCC_SHA@")
    else()
      set(_src [==[@PALEO_PI_CXX_FILE@]==])
      set(_expected "@PALEO_PI_CXX_SHA@")
    endif()
    if(NOT DEFINED PI_BUILD_PREFIX)
      set(_src "${_build_loader}/${_lib}")
    endif()
    file(MAKE_DIRECTORY "${_loader}")
    if(NOT EXISTS "${_loader}/${_lib}")
      file(SHA256 "${_src}" _actual)
      if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Pinned Pi loader library changed: ${_src}")
      endif()
      file(COPY_FILE "${_src}" "${_loader}/${_lib}.tmp")
      file(RENAME "${_loader}/${_lib}.tmp" "${_loader}/${_lib}")
    endif()
    file(SHA256 "${_loader}/${_lib}" _actual)
    if(NOT _actual STREQUAL _expected)
      message(FATAL_ERROR "Invalid published Pi loader library: ${_lib}")
    endif()
  endforeach()
endif()
set(_pi_destination "${_pi_generations}/${_pi_anchor}")
if(EXISTS "${_pi_destination}")
  _pi_verify("${_pi_destination}")
else()
  if(NOT IS_DIRECTORY "${_pi_source}")
    message(FATAL_ERROR "Expected pinned Pi generation at ${_pi_source}. Build paleo_pi_runtime or supply PALEO_PI_INSTALL_ROOT.")
  endif()
  _pi_verify("${_pi_source}")
  string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef _pi_nonce)
  set(_pi_stage "${_pi_generations}/.pi-stage-${_pi_nonce}")
  foreach(_pi_file IN LISTS _pi_files)
    get_filename_component(_pi_parent "${_pi_stage}/${_pi_file}" DIRECTORY)
    file(MAKE_DIRECTORY "${_pi_parent}")
    file(COPY_FILE "${_pi_source}/${_pi_file}" "${_pi_stage}/${_pi_file}")
  endforeach()
  _pi_verify("${_pi_stage}")
  file(CHMOD_RECURSE "${_pi_stage}" FILE_PERMISSIONS OWNER_READ GROUP_READ WORLD_READ
    DIRECTORY_PERMISSIONS OWNER_READ OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  file(CHMOD "${_pi_stage}/${_pi_node}" PERMISSIONS OWNER_READ OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  file(RENAME "${_pi_stage}" "${_pi_destination}")
endif()
message(STATUS "Bundled Pi generation verified: ${_pi_destination}")
