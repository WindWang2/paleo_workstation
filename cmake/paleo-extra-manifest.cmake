# Validate the whole feature manifest before including any feature file.
function(paleo_validate_extra_manifest source_root)
  set(_seen "")
  foreach(_file IN LISTS ARGN)
    if(_file IN_LIST _seen)
      message(FATAL_ERROR "extra manifest duplicate entry: ${_file}")
    endif()
    list(APPEND _seen "${_file}")
    if(NOT EXISTS "${_file}")
      message(FATAL_ERROR "extra manifest entry missing from disk: ${_file}")
    endif()
  endforeach()
  if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB _ondisk "${source_root}/cmake/extra-*.cmake")
  else()
    file(GLOB _ondisk CONFIGURE_DEPENDS "${source_root}/cmake/extra-*.cmake")
  endif()
  foreach(_file IN LISTS _ondisk)
    if(NOT _file IN_LIST _seen)
      message(FATAL_ERROR "extra file not registered in _paleo_extra_manifest: ${_file}")
    endif()
  endforeach()
endfunction()
