set(PALEO_ONNXRUNTIME "AUTO" CACHE STRING "Use pinned ONNX Runtime: AUTO, ON, or OFF")
set_property(CACHE PALEO_ONNXRUNTIME PROPERTY STRINGS AUTO ON OFF)
if(NOT PALEO_ONNXRUNTIME MATCHES "^(AUTO|ON|OFF)$")
  message(FATAL_ERROR "PALEO_ONNXRUNTIME must be AUTO, ON, or OFF")
endif()
set(PALEO_LOCKED_ORT FALSE)
if(PALEO_ONNXRUNTIME STREQUAL "OFF" OR
   (PALEO_ONNXRUNTIME STREQUAL "AUTO" AND ORT_INCLUDE STREQUAL "OFF" AND ORT_LIB STREQUAL "OFF"))
  return()
endif()

set(_paleo_ort_prefix "${CMAKE_SOURCE_DIR}/vendor/onnxruntime")
if(NOT EXISTS "${_paleo_ort_prefix}" AND PALEO_ONNXRUNTIME STREQUAL "AUTO")
  return()
endif()
file(REAL_PATH "${_paleo_ort_prefix}" _paleo_ort_prefix)
file(READ "${CMAKE_SOURCE_DIR}/vendor/manifest.json" _paleo_vendor_manifest)
string(JSON _paleo_ort_version GET "${_paleo_vendor_manifest}" deps onnxruntime version)
set(ORT_INCLUDE "${_paleo_ort_prefix}/include")
if(WIN32)
  set(ORT_LIB "${_paleo_ort_prefix}/lib/onnxruntime.lib")
  set(ORT_DLL "${_paleo_ort_prefix}/lib/onnxruntime.dll")
  set(_paleo_ort_binary "${ORT_DLL}" "${_paleo_ort_prefix}/lib/onnxruntime_providers_shared.dll")
else()
  string(JSON _paleo_ort_real GET "${_paleo_vendor_manifest}" deps onnxruntime linux-x64 real)
  set(ORT_LIB "${_paleo_ort_prefix}/lib/libonnxruntime.so")
  set(_paleo_ort_binary "${_paleo_ort_prefix}/lib/${_paleo_ort_real}"
                        "${_paleo_ort_prefix}/lib/libonnxruntime_providers_shared.so")
endif()
foreach(required IN ITEMS "${ORT_INCLUDE}/onnxruntime_c_api.h"
    "${ORT_INCLUDE}/onnxruntime_cxx_api.h" "${ORT_LIB}" ${_paleo_ort_binary})
  file(REAL_PATH "${required}" resolved)
  cmake_path(IS_PREFIX _paleo_ort_prefix "${resolved}" NORMALIZE inside)
  if(NOT inside OR NOT EXISTS "${required}")
    message(FATAL_ERROR "Pinned ONNX Runtime ${_paleo_ort_version} is incomplete at ${required}. Run bootstrap.")
  endif()
endforeach()
if(WIN32)
  # Windows can resolve the system ORT before PATH. Place the locked DLLs
  # beside the application and test binaries for both supported build entries.
  foreach(library IN LISTS _paleo_ort_binary)
    get_filename_component(name "${library}" NAME)
    configure_file("${library}" "${CMAKE_BINARY_DIR}/${name}" COPYONLY)
  endforeach()
endif()
set(PALEO_LOCKED_ORT TRUE)
