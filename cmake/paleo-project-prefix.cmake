# Select and attest the managed prefix before importing project dependencies.
set(QGIS_PREFIX "" CACHE PATH "Prepared Paleo dependency prefix")
if(NOT QGIS_PREFIX)
  if(DEFINED ENV{QGIS_PREFIX_PATH} AND NOT "$ENV{QGIS_PREFIX_PATH}" STREQUAL "")
    set(_paleo_environment_prefix "$ENV{QGIS_PREFIX_PATH}")
    if(WIN32 AND EXISTS "${_paleo_environment_prefix}/../../.paleo-osgeo4w-lock.sha256")
      file(REAL_PATH "${_paleo_environment_prefix}/../.." _paleo_environment_prefix)
    endif()
    set(QGIS_PREFIX "${_paleo_environment_prefix}" CACHE PATH "Prepared Paleo dependency prefix" FORCE)
  elseif(WIN32)
    set(QGIS_PREFIX "${CMAKE_SOURCE_DIR}/vendor/osgeo4w" CACHE PATH "Prepared Paleo dependency prefix" FORCE)
  elseif(EXISTS "${CMAKE_SOURCE_DIR}/vendor/superbuild/prefix/.paleo-superbuild-base.sha256")
    set(QGIS_PREFIX "${CMAKE_SOURCE_DIR}/vendor/superbuild/prefix" CACHE PATH "Prepared Paleo dependency prefix" FORCE)
  else()
    set(QGIS_PREFIX "${CMAKE_SOURCE_DIR}/vendor/prefix/usr" CACHE PATH "Prepared Paleo dependency prefix" FORCE)
  endif()
endif()

if(NOT IS_DIRECTORY "${QGIS_PREFIX}")
  message(FATAL_ERROR "Missing prepared QGIS_PREFIX '${QGIS_PREFIX}'. "
    "Run paleo-dev bootstrap fetch-only or configure using the prepared source prefix in BUILDING.md.")
endif()
file(REAL_PATH "${QGIS_PREFIX}" _paleo_project_prefix)
include("${CMAKE_CURRENT_LIST_DIR}/paleo-deb-prefix.cmake")

if(WIN32)
  set(_paleo_supply_receipt "${_paleo_project_prefix}/.paleo-osgeo4w-lock.sha256")
  file(SHA256 "${CMAKE_SOURCE_DIR}/vendor/osgeo4w-offline.lock.json" _paleo_supply_hash)
elseif(PALEO_DEB_PREFIX)
  # paleo-deb-prefix.cmake already verified the archive receipt and required resources.
  unset(_paleo_supply_receipt)
else()
  set(_paleo_supply_receipt "${_paleo_project_prefix}/.paleo-superbuild-base.sha256")
  file(READ "${CMAKE_SOURCE_DIR}/vendor/superbuild/debian13-base.lock" _paleo_source_lock)
  string(REPLACE "\r" "" _paleo_source_lock "${_paleo_source_lock}")
  string(SHA256 _paleo_supply_hash "${_paleo_source_lock}")
  find_program(_paleo_receipt_python NAMES python3 REQUIRED)
  execute_process(COMMAND "${_paleo_receipt_python}" "${CMAKE_SOURCE_DIR}/vendor/superbuild/source_receipt.py"
    verify "${_paleo_project_prefix}" COMMAND_ERROR_IS_FATAL ANY)
endif()
if(DEFINED _paleo_supply_receipt)
  if(EXISTS "${_paleo_supply_receipt}")
    file(STRINGS "${_paleo_supply_receipt}" _paleo_actual_hash LIMIT_COUNT 1)
  endif()
  if(NOT _paleo_supply_hash STREQUAL _paleo_actual_hash)
    message(FATAL_ERROR "QGIS_PREFIX does not match a prepared dependency lock: ${QGIS_PREFIX}. "
      "Prepare the prefix using the matching route in BUILDING.md.")
  endif()
endif()

if(PALEO_DEPENDENCY_PREFIX)
  file(REAL_PATH "${PALEO_DEPENDENCY_PREFIX}" _paleo_explicit_prefix)
  if(NOT _paleo_project_prefix STREQUAL _paleo_explicit_prefix)
    message(FATAL_ERROR "QGIS_PREFIX and PALEO_DEPENDENCY_PREFIX must select the same dependency prefix.")
  endif()
endif()
set(PALEO_DEPENDENCY_PREFIX "${_paleo_project_prefix}")
list(PREPEND CMAKE_PREFIX_PATH "${PALEO_DEPENDENCY_PREFIX}" "${PALEO_DEPENDENCY_PREFIX}/apps/qt6")

set(PALEO_QGIS_RUNTIME_PREFIX "${PALEO_DEPENDENCY_PREFIX}")
if(WIN32)
  string(APPEND PALEO_QGIS_RUNTIME_PREFIX "/apps/qgis")
  set(_paleo_opencl_receipt "${PALEO_DEPENDENCY_PREFIX}/.paleo-opencl-source.sha256")
  paleo_require_dependency_path("${_paleo_opencl_receipt}" "OpenCL source receipt")
  file(STRINGS "${_paleo_opencl_receipt}" _paleo_opencl_actual LIMIT_COUNT 1)
  file(SHA256 "${CMAKE_SOURCE_DIR}/vendor/opencl-source.lock.json" _paleo_opencl_expected)
  if(NOT _paleo_opencl_actual STREQUAL _paleo_opencl_expected)
    message(FATAL_ERROR "OpenCL runtime lock mismatch. Run paleo-dev.ps1 bootstrap fetch-only.")
  endif()
  # Windows resolves System32 before PATH, so the build executables need their
  # pinned CRT and OpenCL loader beside them as well as in the portable package.
  set(PALEO_WINDOWS_RUNTIME_DLLS)
  foreach(_paleo_runtime IN ITEMS OpenCL.dll msvcp140.dll msvcp140_1.dll msvcp140_2.dll
          msvcp140_atomic_wait.dll msvcp140_codecvt_ids.dll vcomp140.dll
          vcruntime140.dll vcruntime140_1.dll vcruntime140_threads.dll)
    set(_paleo_runtime_source "${PALEO_DEPENDENCY_PREFIX}/bin/${_paleo_runtime}")
    paleo_require_dependency_path("${_paleo_runtime_source}" "${_paleo_runtime}")
    list(APPEND PALEO_WINDOWS_RUNTIME_DLLS "${_paleo_runtime_source}")
  endforeach()
  include("${CMAKE_CURRENT_LIST_DIR}/paleo-windows-runtime.cmake")
  paleo_stage_windows_runtime(${PALEO_WINDOWS_RUNTIME_DLLS})
  foreach(asset IN ITEMS plugins/platforms/qoffscreen.dll plugins/platforms/qwindows.dll
                          plugins/sqldrivers/qsqlite.dll bin/QtWebEngineProcess.exe
                          resources/qtwebengine_resources.pak translations/qtwebengine_locales/en-US.pak)
    paleo_require_dependency_path("${PALEO_DEPENDENCY_PREFIX}/apps/qt6/${asset}" "${asset}")
  endforeach()
endif()
foreach(_paleo_qgis_data IN ITEMS resources/srs.db resources/symbology-style.xml)
  if(WIN32)
    set(_paleo_qgis_data_path "${PALEO_QGIS_RUNTIME_PREFIX}/${_paleo_qgis_data}")
  else()
    set(_paleo_qgis_data_path "${PALEO_QGIS_RUNTIME_PREFIX}/share/qgis/${_paleo_qgis_data}")
  endif()
  paleo_require_dependency_path("${_paleo_qgis_data_path}" "${_paleo_qgis_data}")
endforeach()
message(STATUS "Paleo locked dependency prefix: ${PALEO_DEPENDENCY_PREFIX}")
