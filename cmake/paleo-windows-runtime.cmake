# The Windows loader searches the executable directory before System32.
function(paleo_stage_windows_runtime)
  set(destinations "${CMAKE_BINARY_DIR}")
  foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES)
    list(APPEND destinations "${CMAKE_BINARY_DIR}/${config}")
  endforeach()
  foreach(dir IN LISTS destinations)
    file(MAKE_DIRECTORY "${dir}")
    foreach(library IN LISTS ARGN)
      get_filename_component(name "${library}" NAME)
      configure_file("${library}" "${dir}/${name}" COPYONLY)
    endforeach()
  endforeach()
endfunction()
