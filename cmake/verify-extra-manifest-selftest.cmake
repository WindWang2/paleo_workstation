cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED PALEO_EXTRA_MANIFEST_SELFTEST_DIR)
  message(FATAL_ERROR "Set PALEO_EXTRA_MANIFEST_SELFTEST_DIR to a scratch directory")
endif()
get_filename_component(_scratch "${PALEO_EXTRA_MANIFEST_SELFTEST_DIR}" ABSOLUTE)
string(RANDOM LENGTH 12 ALPHABET abcdef0123456789 _suffix)
set(_fixture "${_scratch}/extra-manifest-${_suffix}")
set(_validator "${CMAKE_CURRENT_LIST_DIR}/paleo-extra-manifest.cmake")
file(MAKE_DIRECTORY "${_fixture}")

function(check_case name files manifest expected)
  set(_root "${_fixture}/${name}")
  file(MAKE_DIRECTORY "${_root}/cmake")
  foreach(_name IN LISTS files)
    file(WRITE "${_root}/cmake/extra-${_name}.cmake" "# fixture\n")
  endforeach()
  set(_arguments "")
  foreach(_name IN LISTS manifest)
    string(APPEND _arguments " \"${_root}/cmake/extra-${_name}.cmake\"")
  endforeach()
  set(_runner "${_root}/run.cmake")
  file(WRITE "${_runner}" "cmake_minimum_required(VERSION 3.28)\ninclude(\"${_validator}\")\npaleo_validate_extra_manifest(\"${_root}\"${_arguments})\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${_runner}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  if(expected STREQUAL "pass")
    if(NOT _result EQUAL 0)
      message(FATAL_ERROR "${name}: valid manifest rejected: ${_out}${_err}")
    endif()
  elseif(_result EQUAL 0 OR NOT "${_out}${_err}" MATCHES "${expected}")
    message(FATAL_ERROR "${name}: expected ${expected}, got ${_result}: ${_out}${_err}")
  endif()
  message(STATUS "extra manifest selftest: ${name} passed")
endfunction()

check_case(valid "a;b" "a;b" pass)
check_case(empty "" "" pass)
check_case(missing "a" "a;b" "missing from disk")
check_case(unregistered "a;b" "a" "not registered")
check_case(duplicate "a" "a;a" "duplicate entry")
# Delete only the fresh fixture beneath the explicitly named scratch directory.
cmake_path(IS_PREFIX _scratch "${_fixture}" NORMALIZE _inside)
if(NOT _inside OR _fixture STREQUAL _scratch)
  message(FATAL_ERROR "Refusing to remove fixture outside scratch directory")
endif()
file(REMOVE_RECURSE "${_fixture}")
