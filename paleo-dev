#!/usr/bin/env bash
# paleo-dev — unified dev entry (§44.2). Thin wrapper: verbs delegate to cmake/ninja/ctest.
set -euo pipefail
cd "$(dirname "$0")"

BUILD_DIR=build

# 依赖来源策略（BUILDING.md「依赖来源策略」）：superbuild 首选 > deb 闭包
# 加速档 > 系统包兜底。显式 QGIS_PREFIX_PATH 优先，不覆盖；注入后
# build/test/selfcheck 全部 verb 自动走 vendored prefix，无需手工导出。
# deb 闭包里 Qt/GDAL 等库落在 multiarch 子目录（usr/lib/x86_64-linux-gnu），
# 只导出 usr/lib 会让 vendored rcc/moc 回落加载宿主 Qt（#76）。
paleo_multiarch() {
  dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || echo "$(uname -m)-linux-gnu"
}
paleo_deb_libpath() {
  local p="$PWD/vendor/prefix/usr/lib"
  local ma="$p/$(paleo_multiarch)"
  if [ -d "$ma" ]; then echo "$ma:$p"; else echo "$p"; fi
}
if [ -z "${QGIS_PREFIX_PATH:-}" ]; then
  if [ -d vendor/superbuild/prefix/lib ]; then
    export QGIS_PREFIX_PATH="$PWD/vendor/superbuild/prefix"
    export LD_LIBRARY_PATH="$PWD/vendor/superbuild/prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  elif [ -d vendor/prefix/usr ]; then
    export QGIS_PREFIX_PATH="$PWD/vendor/prefix/usr"
    export LD_LIBRARY_PATH="$(paleo_deb_libpath)${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  fi
fi

# 并行度上限（AGENTS.md「构建/测试一律 -j8 以内」，#230）：缺省 min(核数, 8)；
# PALEO_JOBS 可调低，超过 8 一律钳回 8。用户显式传 -j/--parallel 时照传不抢。
paleo_jobs() {
  local n="${PALEO_JOBS:-$(nproc 2>/dev/null || echo 4)}"
  case "$n" in ''|*[!0-9]*) n=4 ;; esac
  [ "$n" -lt 1 ] && n=1
  [ "$n" -gt 8 ] && n=8
  echo "$n"
}
paleo_has_jobs_arg() {
  local a
  for a in "$@"; do
    case "$a" in -j|-j*|--parallel|--parallel=*) return 0 ;; --) return 1 ;; esac
  done
  return 1
}

usage() { awk '/^# paleo-dev —/{print;next} /^# verbs:/{p=1} p&&/^$/{exit} p' "$0"; exit "${1:-0}"; }
# verbs:
#   bootstrap [fetch-only]  preflight -> vendor fetch/build -> selfcheck (the one-command TTHW path)
#                           （fetch-only：只取依赖跳过尾部 build/selfcheck，透传 vendor/bootstrap.sh）
#   build        incremental build
#   test         QT_QPA_PLATFORM=offscreen ctest
#   selfcheck    provider/srs.db/render check -> vendor/logs/map.png
#   clean-vendor [dep]   remove vendored dep (all if no arg)

verb=${1:-}; shift || true
case "$verb" in
  bootstrap)
    bash vendor/bootstrap.sh "$@"
    ;;
  build)
    cmake -S . -B "$BUILD_DIR" -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo
    if paleo_has_jobs_arg "$@"; then
      cmake --build "$BUILD_DIR" "$@"
    else
      cmake --build "$BUILD_DIR" --parallel "$(paleo_jobs)" "$@"
    fi
    ;;
  test)
    # ET1 消费侧：deb 闭包路（vendor/prefix 存在）自动注入 prefix 与动态库
    # 路径——测试 main() 读 QGIS_PREFIX_PATH（缺省 /usr），无需手工导出。
    # 仅在用户显式 bootstrap 过 deb 路时接管；想回系统包 rm -rf vendor/prefix。
    if [ -d vendor/prefix/usr ]; then
      export QGIS_PREFIX_PATH="$PWD/vendor/prefix/usr"
      export LD_LIBRARY_PATH="$(paleo_deb_libpath)${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    fi
    # 闭包 GDAL 的格式插件（gdal_PNG/JPEG/...）不在编译期默认搜索路径上：
    # 不注入则栅格类测试（tst_previewmap_assets 的 world-file 图等）静默
    # 丢驱动。vendor/prefix 与外部 QGIS_PREFIX_PATH 两种来源都覆盖；用户
    # 已显式给 GDAL_DRIVER_PATH 时不抢。
    prefix_lib="${QGIS_PREFIX_PATH:-}"
    if [ -n "$prefix_lib" ] && [ -z "${GDAL_DRIVER_PATH:-}" ]; then
      for cand in "$prefix_lib/lib/gdalplugins" "$prefix_lib/lib/x86_64-linux-gnu/gdalplugins"; do
        if [ -d "$cand" ]; then export GDAL_DRIVER_PATH="$cand"; break; fi
      done
    fi
    # ctest 默认并行 min(核数, 8)（T2：每测试有独立 XDG 沙箱，并行安全；
    # #230：-j8 上限）；传 --parallel/-j 时用户参数照传。
    mkdir -p "$BUILD_DIR/Testing/qtest-first-run"
    if paleo_has_jobs_arg "$@"; then
      QT_QPA_PLATFORM=offscreen ctest --test-dir "$BUILD_DIR" --output-on-failure \
        --output-junit "$PWD/$BUILD_DIR/Testing/ctest-junit.xml" "$@"
    else
      QT_QPA_PLATFORM=offscreen ctest --test-dir "$BUILD_DIR" --output-on-failure \
        --output-junit "$PWD/$BUILD_DIR/Testing/ctest-junit.xml" -j "$(paleo_jobs)" "$@"
    fi
    ;;
  selfcheck)
    mkdir -p vendor/logs
    QT_QPA_PLATFORM=offscreen "$BUILD_DIR/paleo_selfcheck" "$@"
    ;;
  clean-vendor)
    dep=${1:-}
    if [ -z "$dep" ]; then rm -rf vendor/build vendor/prefix vendor/superbuild/prefix vendor/onnxruntime vendor/libreoffice; echo "vendor build tree cleared (archives kept)";
    else
      case "$dep" in
        .|..|*[!A-Za-z0-9._-]*) echo "invalid vendor dependency name: $dep" >&2; exit 2 ;;
      esac
      rm -rf -- "vendor/build/$dep" "vendor/prefix/$dep"
      if [ "$dep" = onnxruntime ]; then rm -rf -- vendor/onnxruntime; fi
      if [ "$dep" = libreoffice ]; then rm -rf -- vendor/libreoffice; fi
      echo "vendor/$dep cleared"
    fi
    ;;
  --help|-h|""|help) usage ;;
  *) echo "unknown verb: $verb" >&2; usage 1 ;;
esac
