#!/usr/bin/env bash
# paleo-dev — unified dev entry (§44.2). Thin wrapper: verbs delegate to cmake/ninja/ctest.
set -euo pipefail
cd "$(dirname "$0")"

BUILD_DIR="${BUILD_DIR:-build}"
[[ "$BUILD_DIR" == /* ]] || BUILD_DIR="$PWD/$BUILD_DIR"

paleo_multiarch() {
  dpkg-architecture -qDEB_HOST_MULTIARCH 2>/dev/null || echo "$(uname -m)-linux-gnu"
}
paleo_activate_deps() {
  local prefix="${QGIS_PREFIX_PATH:-}"
  if [ -z "$prefix" ]; then
    if [ -s vendor/superbuild/prefix/.paleo-superbuild-base.sha256 ]; then
      prefix="$PWD/vendor/superbuild/prefix"
    else
      prefix="$PWD/vendor/prefix/usr"
    fi
  fi
  if [ ! -d "$prefix" ]; then
    echo "Missing prepared dependency prefix $prefix. Run ./paleo-dev bootstrap fetch-only." >&2
    return 1
  fi
  prefix=$(cd -P -- "$prefix" && pwd)
  if [ -s "$prefix/.paleo-superbuild-base.sha256" ]; then
    source vendor/superbuild/activate.sh "$prefix"
    return
  fi
  export QGIS_PREFIX_PATH="$prefix"
  local receipt="${prefix%/*}/.paleo-deb-closure.sha256"
  if [[ "$prefix" -ef "$PWD/vendor/prefix/usr" || -f "$receipt" ]]; then
    local wanted
    wanted=$(tr -d '\r' < vendor/deb-closure.lock | sha256sum | cut -d' ' -f1)
    if [ "$(cat "$receipt" 2>/dev/null)" != "$wanted" ]; then
      echo "Deb prefix lock mismatch at $prefix. Run ./paleo-dev bootstrap fetch-only." >&2
      return 1
    fi
    local multiarch="$prefix/lib/$(paleo_multiarch)"
    export GISBASE="$prefix/lib/grass84"
    export LD_LIBRARY_PATH="$multiarch:$prefix/lib:$GISBASE/lib:$PWD/vendor/onnxruntime/lib"
    export PATH="$prefix/lib/qt6/bin:$prefix/lib/qt6/libexec:$PATH"
    export CMAKE_PREFIX_PATH="$prefix"
    export PKG_CONFIG_LIBDIR="$multiarch/pkgconfig:$prefix/lib/pkgconfig:$prefix/share/pkgconfig"
    export PKG_CONFIG_SYSROOT_DIR="${prefix%/usr}"
    unset PKG_CONFIG_PATH
    export QT_PLUGIN_PATH="$multiarch/qt6/plugins"
    export QCA_PLUGIN_PATH="$multiarch/qca-qt6"
    export QT_QPA_PLATFORM_PLUGIN_PATH="$QT_PLUGIN_PATH/platforms"
    export FONTCONFIG_PATH="${prefix%/usr}/etc/fonts" FONTCONFIG_FILE="${prefix%/usr}/etc/fonts/fonts.conf"
    unset FONTCONFIG_SYSROOT
    export QTWEBENGINEPROCESS_PATH="$prefix/lib/qt6/libexec/QtWebEngineProcess"
    export QTWEBENGINE_RESOURCES_PATH="$prefix/share/qt6/resources"
    export QTWEBENGINE_LOCALES_PATH="$prefix/share/qt6/translations/qtwebengine_locales"
    export PROJ_DATA="$prefix/share/proj" PROJ_LIB="$prefix/share/proj"
    export GDAL_DATA="$prefix/share/gdal" GDAL_DRIVER_PATH="$multiarch/gdalplugins"
    return 0
  fi

  echo "QGIS prefix $prefix does not match a Paleo dependency lock. See BUILDING.md." >&2
  return 1
}

paleo_configure() {
  if [ -f "$BUILD_DIR/CMakeCache.txt" ]; then
    cmake -S . -B "$BUILD_DIR" "$@"
  else
    cmake -S . -B "$BUILD_DIR" -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo "$@"
  fi
}

# 并行度上限（AGENTS.md「构建/测试一律 -j8 以内」，#230）：缺省 min(核数, 8)；
# PALEO_JOBS 可调低，超过 8 一律钳回 8。用户显式传 -j/--parallel 时照传不抢。
paleo_jobs() {
  local n="${PALEO_JOBS:-$(nproc 2>/dev/null || echo 4)}"
  case "$n" in ''|*[!0-9]*) n=4 ;; esac
  [ "$n" -lt 1 ] && n=1
  [ "$n" -gt 8 ] && n=8
  echo "$n"
}
paleo_has_jobs_arg() {
  local a
  for a in "$@"; do
    case "$a" in -j|-j*|--parallel|--parallel=*) return 0 ;; --) return 1 ;; esac
  done
  return 1
}

usage() { awk '/^# paleo-dev —/{print;next} /^# verbs:/{p=1} p&&/^$/{exit} p' "$0"; exit "${1:-0}"; }
# verbs:
#   bootstrap [fetch-only]  preflight -> vendor fetch/build -> selfcheck (the one-command TTHW path)
#                           （fetch-only：只取依赖跳过尾部 build/selfcheck，透传 vendor/bootstrap.sh）
#   configure    prepare a build directory with CMake options
#   build        incremental build
#   test         QT_QPA_PLATFORM=offscreen ctest
#   selfcheck    provider/srs.db/render check -> vendor/logs/map.png
#   clean-vendor [dep]   remove vendored dep (all if no arg)

verb=${1:-}; shift || true
case "$verb" in
  configure|build|test|selfcheck) paleo_activate_deps ;;
esac
case "$verb" in
  bootstrap)
    bash vendor/bootstrap.sh "$@"
    ;;
  configure)
    paleo_configure "$@"
    ;;
  build)
    paleo_configure
    if paleo_has_jobs_arg "$@"; then
      cmake --build "$BUILD_DIR" "$@"
    else
      cmake --build "$BUILD_DIR" --parallel "$(paleo_jobs)" "$@"
    fi
    ;;
  test)
    # ctest 默认并行 min(核数, 8)（T2：每测试有独立 XDG 沙箱，并行安全；
    # #230：-j8 上限）；传 --parallel/-j 时用户参数照传。
    mkdir -p "$BUILD_DIR/Testing/qtest-first-run"
    if paleo_has_jobs_arg "$@"; then
      QT_QPA_PLATFORM=offscreen ctest --test-dir "$BUILD_DIR" --output-on-failure \
        --output-junit "$BUILD_DIR/Testing/ctest-junit.xml" "$@"
    else
      QT_QPA_PLATFORM=offscreen ctest --test-dir "$BUILD_DIR" --output-on-failure \
        --output-junit "$BUILD_DIR/Testing/ctest-junit.xml" -j "$(paleo_jobs)" "$@"
    fi
    ;;
  selfcheck)
    mkdir -p vendor/logs
    QT_QPA_PLATFORM=offscreen "$BUILD_DIR/paleo_selfcheck" "$@"
    ;;
  clean-vendor)
    dep=${1:-}
    if [ -z "$dep" ]; then rm -rf vendor/build vendor/prefix vendor/superbuild/prefix vendor/onnxruntime; echo "vendor build tree cleared (archives kept)";
    else
      case "$dep" in
        .|..|*[!A-Za-z0-9._-]*) echo "invalid vendor dependency name: $dep" >&2; exit 2 ;;
      esac
      rm -rf -- "vendor/build/$dep" "vendor/prefix/$dep"
      if [ "$dep" = onnxruntime ]; then rm -rf -- vendor/onnxruntime; fi
      echo "vendor/$dep cleared"
    fi
    ;;
  --help|-h|""|help) usage ;;
  *) echo "unknown verb: $verb" >&2; usage 1 ;;
esac
