+// Paleo labelsWithLayer: returns TRUE when the layer's labels act as a
+// selective masking source for other layers' symbol layers (text mask or
+// label mask source set -- the same sources prepareSecondPassJobs collects
+// via QgsVectorLayerUtils::collectObjectsMaskedByLabelsFromLayer). Such layers
+// must keep the shared labeling engine so their labels still generate the
+// mask images the second pass needs.
+static bool paleoLabelsAreMaskSource( QgsMapLayer *layer, const QgsMapSettings &settings )
+{
+  QgsVectorLayer *vl = qobject_cast<QgsVectorLayer *>( layer );
+  if ( !vl || !vl->labeling() )
+    return false;
+
+  QVector<QgsVectorLayer *> allVectorLayers;
+  const QList<QgsMapLayer *> layers = settings.layers();
+  allVectorLayers.reserve( layers.size() );
+  for ( QgsMapLayer *l : layers )
+  {
+    if ( QgsVectorLayer *v = qobject_cast<QgsVectorLayer *>( l ) )
+      allVectorLayers << v;
+  }
+  return !QgsVectorLayerUtils::collectObjectsMaskedByLabelsFromLayer( vl, settings.selectiveMaskingSourceSets(), allVectorLayers ).isEmpty();
+}
