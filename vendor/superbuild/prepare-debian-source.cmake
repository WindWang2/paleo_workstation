cmake_minimum_required(VERSION 3.28)

# The source index and each constituent archive are pinned from signed Debian
# metadata. dpkg-source reapplies the Debian and security patches.
find_program(dpkg_source_program dpkg-source REQUIRED)
file(MAKE_DIRECTORY "${SOURCE_CACHE}")
file(LOCK "${SOURCE_CACHE}/.debian-source.lock" GUARD PROCESS TIMEOUT 120)
file(STRINGS "${CMAKE_CURRENT_LIST_DIR}/debian-sources.lock" rows)
unset(description)
foreach(row IN LISTS rows)
  if(NOT row MATCHES "^${SOURCE_PACKAGE} ")
    continue()
  endif()
  if(NOT row MATCHES "^[a-z0-9]+ (https://deb.debian.org/[^ ]+) ([A-Za-z0-9.+_~-]+) ([0-9]+) ([0-9a-f]+)$")
    message(FATAL_ERROR "Invalid locked Debian source row ${row}")
  endif()
  set(url "${CMAKE_MATCH_1}")
  set(name "${CMAKE_MATCH_2}")
  set(size "${CMAKE_MATCH_3}")
  set(hash "${CMAKE_MATCH_4}")
  set(archive "${SOURCE_CACHE}/${name}")
  if(NOT EXISTS "${archive}")
    if(OFFLINE)
      message(FATAL_ERROR "Missing offline source archive ${archive}")
    endif()
    file(DOWNLOAD "${url}" "${archive}.part" EXPECTED_HASH SHA256=${hash}
      TLS_VERIFY ON TIMEOUT 120)
    file(RENAME "${archive}.part" "${archive}")
  endif()
  file(SIZE "${archive}" actual_size)
  file(SHA256 "${archive}" actual_hash)
  if(NOT actual_size EQUAL size OR NOT actual_hash STREQUAL hash)
    message(FATAL_ERROR "Size or SHA-256 mismatch for ${archive}")
  endif()
  if(name MATCHES "\\.dsc$")
    if(description)
      message(FATAL_ERROR "Multiple Debian source descriptors for ${SOURCE_PACKAGE}")
    endif()
    set(description "${archive}")
  endif()
endforeach()
if(NOT description)
  message(FATAL_ERROR "No Debian source descriptor for ${SOURCE_PACKAGE}")
endif()

string(RANDOM LENGTH 10 nonce)
set(scratch "${SOURCE_TREE}.unpack-${nonce}")
# The locked SHA-256 checks above cover the .dsc and every input to extraction.
execute_process(COMMAND "${dpkg_source_program}" --no-check -x "${description}" "${scratch}"
  COMMAND_ERROR_IS_FATAL ANY)
file(COPY "${scratch}/" DESTINATION "${SOURCE_TREE}")
file(REMOVE_RECURSE "${scratch}")
